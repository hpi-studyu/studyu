{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "enabledManagers": ["pub"],
  "packageRules": [
    {
      "description": "Disable major updates",
      "matchUpdateTypes": ["major"],
      "enabled": false
    },
    {
      "description": "Group weekly minor and patch updates",
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "Safe Flutter Updates",
      "schedule": ["* 0-4 * * 1"],
      "commitMessagePrefix": "chore(deps):",
      "commitMessageAction": "",
      "commitMessageTopic": "Safe Flutter Updates",
      "commitMessageExtra": "",
      "commitMessageLowerCase": "never",
      "prTitleStrict": true
    }
  ]
}
